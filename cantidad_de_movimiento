#calculo del momento lineal por tramo
MASA = 102 #sujeto + bici

def calcular_momento_lineal_x_promedio_por_tramo(times, velocidades, n_tramos=10):
    total = len(times)
    tramo_len = total // n_tramos
    resul = []

    for i in range(n_tramos):
        inicio = i * tramo_len
        fin = (i + 1) * tramo_len if i < n_tramos - 1 else total

        t_inicio = times[inicio]
        t_fin = times[fin - 1]

        velocidad_prom = sum(velocidad[inicio:fin]) / (fin - inicio)
        promedio_momento_lineal = MASA * velociad_prom

        resultados.append((
            i + 1,         # Número de tramo
            t_inicio,      # Tiempo inicial
            t_fin,         # Tiempo final
            velocidad_prom,   # velocidad promedio
            promedio_momento_lineal   # memento lineal promedio
        ))

    return resul
